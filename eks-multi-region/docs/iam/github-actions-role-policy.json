{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassOnlyTheCfnExecutionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/eks-multi-region-cfn-exec",
      "Condition": {
        "StringEquals": { "iam:PassedToService": "cloudformation.amazonaws.com" }
      }
    },
    {
      "Sid": "FisServiceLinkedRoleCheckAndCreate",
      "Effect": "Allow",
      "Action": ["iam:GetRole", "iam:CreateServiceLinkedRole"],
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/aws-service-role/fis.amazonaws.com/AWSServiceRoleForFIS"
    },
    {
      "Sid": "CloudFormationChangeSets",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:DescribeChangeSet",
        "cloudformation:ExecuteChangeSet",
        "cloudformation:DeleteChangeSet",
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:ListStackResources",
        "cloudformation:ListStacks",
        "cloudformation:DeleteStack",
        "cloudformation:GetTemplateSummary"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AssetsBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:PutBucketPublicAccessBlock",
        "s3:GetBucketPublicAccessBlock",
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucketVersions",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::eks-multi-region-*",
        "arn:aws:s3:::eks-multi-region-*/*"
      ]
    },
    {
      "Sid": "ImageMirrorAndAppImages",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken",
        "ecr:DescribeRepositories",
        "ecr:CreateRepository",
        "ecr:DeleteRepository",
        "ecr:DescribeImages",
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage",
        "ecr:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "EcrPublicAuthenticatedPulls",
      "Effect": "Allow",
      "Action": [
        "ecr-public:GetAuthorizationToken",
        "sts:GetServiceBearerToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "InVpcInstallerBuilds",
      "Effect": "Allow",
      "Action": [
        "codebuild:StartBuild",
        "codebuild:BatchGetBuilds",
        "codebuild:ListBuildsForProject",
        "codebuild:ListProjects"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PostDeployVerification",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster",
        "eks:DescribeNodegroup",
        "eks:ListNodegroups",
        "eks:DeleteCluster",
        "eks:DeleteNodegroup",
        "ec2:DescribeInstances",
        "ec2:DescribeVpcPeeringConnections",
        "ec2:DescribeRouteTables",
        "ec2:DescribeNetworkInterfaces",
        "ec2:DescribeAvailabilityZones",
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "elasticloadbalancing:DescribeLoadBalancers",
        "ssm:DescribeInstanceInformation",
        "arc-region-switch:GetPlan",
        "arc-region-switch:GetPlanExecution",
        "arc-region-switch:GetPlanEvaluationStatus",
        "arc-region-switch:ListPlanExecutions",
        "arc-region-switch:ListRoute53HealthChecks",
        "arc-zonal-shift:GetManagedResource",
        "route53:GetHealthCheckStatus",
        "route53:ListResourceRecordSets"
      ],
      "Resource": "*"
    },
    {
      "Sid": "GlobalWriterEndpointLookup",
      "Effect": "Allow",
      "Action": "rds:DescribeGlobalClusters",
      "Resource": "arn:aws:rds::ACCOUNT_ID:global-cluster:*"
    },
    {
      "Sid": "ArcPlanNoOpUpdateForcesRescan",
      "Effect": "Allow",
      "Action": "arc-region-switch:UpdatePlan",
      "Resource": "arn:aws:arc-region-switch::ACCOUNT_ID:plan/*"
    },
    {
      "Sid": "InstallerBuildLogsOnFailure",
      "Effect": "Allow",
      "Action": "logs:GetLogEvents",
      "Resource": "arn:aws:logs:*:ACCOUNT_ID:log-group:/aws/codebuild/*:log-stream:*"
    },
    {
      "Sid": "ObserverPeeringAccepterStep",
      "Effect": "Allow",
      "Action": [
        "ec2:AcceptVpcPeeringConnection",
        "ec2:CreateRoute",
        "ec2:DeleteRoute"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    }
  ]
}
