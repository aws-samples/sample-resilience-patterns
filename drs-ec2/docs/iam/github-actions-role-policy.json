{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CdkBootstrapRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-deploy-role-ACCOUNT_ID-us-east-1",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-deploy-role-ACCOUNT_ID-us-east-2",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-deploy-role-ACCOUNT_ID-us-west-2",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-file-publishing-role-ACCOUNT_ID-us-east-1",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-file-publishing-role-ACCOUNT_ID-us-east-2",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-file-publishing-role-ACCOUNT_ID-us-west-2",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-image-publishing-role-ACCOUNT_ID-us-east-1",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-image-publishing-role-ACCOUNT_ID-us-east-2",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-image-publishing-role-ACCOUNT_ID-us-west-2",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-lookup-role-ACCOUNT_ID-us-east-1",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-lookup-role-ACCOUNT_ID-us-east-2",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-lookup-role-ACCOUNT_ID-us-west-2"
      ]
    },
    {
      "Sid": "Identity",
      "Effect": "Allow",
      "Action": "sts:GetCallerIdentity",
      "Resource": "*"
    },
    {
      "Sid": "ProjectStacksReadAndDelete",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DescribeStackResources",
        "cloudformation:DeleteStack"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:ACCOUNT_ID:stack/drsdemo-*/*",
        "arn:aws:cloudformation:us-east-2:ACCOUNT_ID:stack/drsdemo-*/*",
        "arn:aws:cloudformation:us-west-2:ACCOUNT_ID:stack/drsdemo-*/*"
      ]
    },
    {
      "Sid": "AppCodeBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:ListBucket",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": "arn:aws:s3:::drsdemo-app-code-ACCOUNT_ID-us-east-2"
    },
    {
      "Sid": "AppCodeObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::drsdemo-app-code-ACCOUNT_ID-us-east-2/*"
    },
    {
      "Sid": "FindRetainedLambdaLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "DeleteOnlyTheProjectLambdaLogGroups",
      "Effect": "Allow",
      "Action": "logs:DeleteLogGroup",
      "Resource": [
        "arn:aws:logs:us-east-2:ACCOUNT_ID:log-group:/aws/lambda/drsdemo-*",
        "arn:aws:logs:us-west-2:ACCOUNT_ID:log-group:/aws/lambda/drsdemo-*"
      ]
    },
    {
      "Sid": "FindDrsCreatedSecurityGroups",
      "Effect": "Allow",
      "Action": "ec2:DescribeSecurityGroups",
      "Resource": "*"
    },
    {
      "Sid": "DeleteDrsCreatedSecurityGroups",
      "Effect": "Allow",
      "Action": "ec2:DeleteSecurityGroup",
      "Resource": [
        "arn:aws:ec2:us-east-2:ACCOUNT_ID:security-group/*",
        "arn:aws:ec2:us-west-2:ACCOUNT_ID:security-group/*"
      ]
    },
    {
      "Sid": "DrsManagedLaunchTemplate",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateLaunchTemplateVersion",
        "ec2:ModifyLaunchTemplate"
      ],
      "Resource": "arn:aws:ec2:us-west-2:ACCOUNT_ID:launch-template/*",
      "Condition": {
        "Null": {
          "aws:ResourceTag/AWSElasticDisasterRecoveryManaged": "false"
        }
      }
    },
    {
      "Sid": "ReadAppInstanceProfile",
      "Effect": "Allow",
      "Action": "iam:GetInstanceProfile",
      "Resource": "arn:aws:iam::ACCOUNT_ID:instance-profile/drsdemo-app-instance-profile"
    },
    {
      "Sid": "PassOnlyTheAppRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/drsdemo-app-instance-role",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "CreateOnlyTheDrsServiceRoles",
      "Effect": "Allow",
      "Action": "iam:CreateRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryAgentRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryFailbackRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryConversionServerRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryRecoveryInstanceRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryReplicationServerRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryRecoveryInstanceWithLaunchActionsRole"
      ]
    },
    {
      "Sid": "AttachOnlyTheDrsManagedPolicies",
      "Effect": "Allow",
      "Action": "iam:AttachRolePolicy",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryAgentRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryFailbackRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryConversionServerRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryRecoveryInstanceRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryReplicationServerRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryRecoveryInstanceWithLaunchActionsRole"
      ],
      "Condition": {
        "ArnEquals": {
          "iam:PolicyARN": [
            "arn:aws:iam::aws:policy/service-role/AWSElasticDisasterRecoveryAgentPolicy",
            "arn:aws:iam::aws:policy/service-role/AWSElasticDisasterRecoveryFailbackPolicy",
            "arn:aws:iam::aws:policy/service-role/AWSElasticDisasterRecoveryConversionServerPolicy",
            "arn:aws:iam::aws:policy/service-role/AWSElasticDisasterRecoveryRecoveryInstancePolicy",
            "arn:aws:iam::aws:policy/service-role/AWSElasticDisasterRecoveryReplicationServerPolicy",
            "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
          ]
        }
      }
    },
    {
      "Sid": "CreateOnlyTheDrsInstanceProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:GetInstanceProfile",
        "iam:CreateInstanceProfile",
        "iam:AddRoleToInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:instance-profile/AWSElasticDisasterRecoveryConversionServerRole",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/AWSElasticDisasterRecoveryRecoveryInstanceRole",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/AWSElasticDisasterRecoveryReplicationServerRole",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/AWSElasticDisasterRecoveryRecoveryInstanceWithLaunchActionsRole",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/service-role/AWSElasticDisasterRecoveryConversionServerRole",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/service-role/AWSElasticDisasterRecoveryRecoveryInstanceRole",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/service-role/AWSElasticDisasterRecoveryReplicationServerRole",
        "arn:aws:iam::ACCOUNT_ID:instance-profile/service-role/AWSElasticDisasterRecoveryRecoveryInstanceWithLaunchActionsRole"
      ]
    },
    {
      "Sid": "PassOnlyTheDrsEc2RolesIntoTheirInstanceProfiles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryConversionServerRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryRecoveryInstanceRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryReplicationServerRole",
        "arn:aws:iam::ACCOUNT_ID:role/service-role/AWSElasticDisasterRecoveryRecoveryInstanceWithLaunchActionsRole"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DrsServiceLinkedRoleOnInitialize",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/aws-service-role/drs.amazonaws.com/AWSServiceRoleForElasticDisasterRecovery",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": "drs.amazonaws.com"
        }
      }
    },
    {
      "Sid": "DrsServiceAndDiscovery",
      "Effect": "Allow",
      "Action": [
        "drs:InitializeService",
        "drs:DescribeSourceServers",
        "drs:DescribeRecoveryInstances",
        "drs:DescribeReplicationConfigurationTemplates",
        "drs:DescribeLaunchConfigurationTemplates",
        "drs:CreateReplicationConfigurationTemplate",
        "drs:CreateLaunchConfigurationTemplate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DrsSourceServers",
      "Effect": "Allow",
      "Action": [
        "drs:GetLaunchConfiguration",
        "drs:GetReplicationConfiguration",
        "drs:UpdateLaunchConfiguration",
        "drs:UpdateReplicationConfiguration",
        "drs:RetryDataReplication",
        "drs:StopReplication",
        "drs:DisconnectSourceServer",
        "drs:DeleteSourceServer",
        "drs:TagResource"
      ],
      "Resource": [
        "arn:aws:drs:us-east-2:ACCOUNT_ID:source-server/*",
        "arn:aws:drs:us-west-2:ACCOUNT_ID:source-server/*"
      ]
    },
    {
      "Sid": "DrsRecoveryInstances",
      "Effect": "Allow",
      "Action": [
        "drs:StopFailback",
        "drs:TerminateRecoveryInstances"
      ],
      "Resource": [
        "arn:aws:drs:us-east-2:ACCOUNT_ID:recovery-instance/*",
        "arn:aws:drs:us-west-2:ACCOUNT_ID:recovery-instance/*"
      ]
    },
    {
      "Sid": "DrsTemplates",
      "Effect": "Allow",
      "Action": [
        "drs:UpdateReplicationConfigurationTemplate",
        "drs:UpdateLaunchConfigurationTemplate"
      ],
      "Resource": [
        "arn:aws:drs:us-east-2:ACCOUNT_ID:replication-configuration-template/*",
        "arn:aws:drs:us-west-2:ACCOUNT_ID:replication-configuration-template/*",
        "arn:aws:drs:us-east-2:ACCOUNT_ID:launch-configuration-template/*"
      ]
    },
    {
      "Sid": "RunAndObserveThePlan",
      "Effect": "Allow",
      "Action": [
        "arc-region-switch:StartPlanExecution",
        "arc-region-switch:GetPlanExecution",
        "arc-region-switch:GetPlanEvaluationStatus",
        "arc-region-switch:ListRoute53HealthChecks"
      ],
      "Resource": "arn:aws:arc-region-switch::ACCOUNT_ID:plan/drsdemo-switchover:*"
    },
    {
      "Sid": "ReadGlobalWriter",
      "Effect": "Allow",
      "Action": "rds:DescribeGlobalClusters",
      "Resource": "arn:aws:rds::ACCOUNT_ID:global-cluster:drsdemo-global"
    },
    {
      "Sid": "ReadSecondaryTargetHealth",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:DescribeTargetHealth",
      "Resource": "arn:aws:elasticloadbalancing:us-west-2:ACCOUNT_ID:targetgroup/drsdemo-secondary-tg/*"
    },
    {
      "Sid": "FindSecondaryTargetGroupByName",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:DescribeTargetGroups",
      "Resource": "*"
    },
    {
      "Sid": "ReadStatefulModeFromTheStepFunction",
      "Effect": "Allow",
      "Action": "lambda:GetFunctionConfiguration",
      "Resource": "arn:aws:lambda:us-west-2:ACCOUNT_ID:function:drsdemo-drs-reverse-replicate"
    },
    {
      "Sid": "RunShellScriptOnProjectInstances",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ssm:us-east-2::document/AWS-RunShellScript",
        "arn:aws:ssm:us-west-2::document/AWS-RunShellScript",
        "arn:aws:ec2:us-east-2:ACCOUNT_ID:instance/*",
        "arn:aws:ec2:us-west-2:ACCOUNT_ID:instance/*"
      ]
    },
    {
      "Sid": "PollCommandsAndManagedInstances",
      "Effect": "Allow",
      "Action": [
        "ssm:GetCommandInvocation",
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DeleteTheRuntimeWriterEndpointParameter",
      "Effect": "Allow",
      "Action": "ssm:DeleteParameter",
      "Resource": "arn:aws:ssm:us-west-2:ACCOUNT_ID:parameter/drsdemo/db-writer-endpoint"
    }
  ]
}
