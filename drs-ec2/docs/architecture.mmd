%% drs-ec2 architecture: Amazon EC2 disaster recovery with AWS Elastic Disaster Recovery (DRS), Amazon Aurora
%% Global Database, Amazon Route 53 failover records and an Amazon Application Recovery Controller (ARC)
%% Region switch plan. Renders inline in GitHub markdown.
%% Solid = steady state; dashed = active only after an ARC failover; red = ARC plan steps; green = replication.
flowchart LR
    dns["Route 53 private zone<br/>app.drsdemo.internal<br/>failover record pair"]
    arc(["ARC Region switch plan<br/>graceful | ungraceful"])

    subgraph EAST["us-east-2 (primary)"]
        albE["ALB"]
        ec2E["EC2 application<br/>+ DRS agent"]
        aurE[("Aurora Global<br/>writer")]
        albE -->|active at rest| ec2E
        ec2E -->|reads / writes| aurE
    end

    subgraph WEST["us-west-2 (secondary)"]
        albW["ALB<br/>(target group empty at rest)"]
        ec2W["recovered EC2<br/>(created at failover)"]
        aurW[("Aurora Global<br/>reader → writer")]
        stage["DRS staging"]
        albW -.->|filled at failover| ec2W
        ec2W -.-> aurW
    end

    dns -->|PRIMARY / hc A| albE
    dns -.->|SECONDARY / hc B| albW

    aurE ===|Aurora Global replication| aurW
    ec2E ===|DRS continuous block replication| stage

    arc -->|Aurora switch| aurW
    arc -->|DRS recover EC2| ec2W
    arc -->|register target| albW
    arc -->|DNS flip| dns

    linkStyle 8,9,10,11 stroke:#b00020,stroke-width:2px;
    linkStyle 6,7 stroke:#2e7d32,stroke-width:2px;
