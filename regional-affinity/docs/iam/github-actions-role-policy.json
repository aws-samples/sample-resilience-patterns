{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CdkBootstrap",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": [
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-deploy-role-ACCOUNT_ID-us-east-1",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-deploy-role-ACCOUNT_ID-us-east-2",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-file-publishing-role-ACCOUNT_ID-us-east-1",
        "arn:aws:iam::ACCOUNT_ID:role/cdk-hnb659fds-file-publishing-role-ACCOUNT_ID-us-east-2"
      ]
    },
    {
      "Sid": "Stacks",
      "Effect": "Allow",
      "Action": [
        "cloudformation:DescribeStacks",
        "cloudformation:DescribeStackEvents",
        "cloudformation:DeleteStack"
      ],
      "Resource": [
        "arn:aws:cloudformation:us-east-1:ACCOUNT_ID:stack/regional-affinity*/*",
        "arn:aws:cloudformation:us-east-2:ACCOUNT_ID:stack/regional-affinity*/*"
      ]
    },
    {
      "Sid": "SeedTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchWriteItem",
        "dynamodb:GetItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:us-east-1:ACCOUNT_ID:table/regional-affinity*-customers",
        "arn:aws:dynamodb:us-east-2:ACCOUNT_ID:table/regional-affinity*-customers"
      ]
    },
    {
      "Sid": "Plan",
      "Effect": "Allow",
      "Action": [
        "arc-region-switch:GetPlan",
        "arc-region-switch:UpdatePlan",
        "arc-region-switch:GetPlanEvaluationStatus",
        "arc-region-switch:ListRoute53HealthChecks",
        "arc-region-switch:StartPlanExecution",
        "arc-region-switch:GetPlanExecution"
      ],
      "Resource": "arn:aws:arc-region-switch::ACCOUNT_ID:plan/regional-affinity*"
    },
    {
      "Sid": "PassPlanRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::ACCOUNT_ID:role/regional-affinity*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "arc-region-switch.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ReadRecords",
      "Effect": "Allow",
      "Action": "route53:ListResourceRecordSets",
      "Resource": "arn:aws:route53:::hostedzone/*"
    },
    {
      "Sid": "Probe",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": [
        "arn:aws:lambda:us-east-1:ACCOUNT_ID:function:regional-affinity*-probe",
        "arn:aws:lambda:us-east-2:ACCOUNT_ID:function:regional-affinity*-probe"
      ]
    }
  ]
}
